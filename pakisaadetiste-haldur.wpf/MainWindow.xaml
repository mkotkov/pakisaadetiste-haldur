<Window x:Class="pakisaadetiste_haldur.wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pakisaadetiste_haldur.wpf"
        xmlns:res="clr-namespace:pakisaadetiste_haldur.wpf.Properties"
        mc:Ignorable="d"
        Title="{x:Static res:Resources.Str_WindowTitle}"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="550"
        Background="#EDF7F6"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- =========================
             COLORS
             ========================= -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#EDF7F6"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#171717"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#737373"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8E7"/>
        <SolidColorBrush x:Key="BlackBrush" Color="#111111"/>


        <!-- =========================
             LABEL
             ========================= -->

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>
        </Style>


        <!-- =========================
             TEXTBOX
             ========================= -->

        <Style x:Key="ModernTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             COMBOBOX
             ========================= -->

        <Style x:Key="ModernComboBox"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"/>

                            <ContentPresenter
                                Margin="13,0,40,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                            <Path
                                Data="M 0 0 L 5 5 L 10 0"
                                Stroke="#737373"
                                StrokeThickness="1.5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0"/>

                            <ToggleButton
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent}}">

                                <ToggleButton.Template>

                                    <ControlTemplate
                                        TargetType="ToggleButton">

                                        <Border
                                            Background="Transparent"/>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <Popup
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                PopupAnimation="Fade">

                                <Border
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Margin="0,5,0,0">

                                    <ScrollViewer
                                        MaxHeight="250">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             BUTTON
             ========================= -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Background"
                    Value="#111111"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#292929"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#000000"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             DANGER BUTTON (kustutamine)
             ========================= -->

        <Style x:Key="DangerButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#FF565656"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#FFE4E4E4"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#FDEDED"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    Property="Opacity"
                                    Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             PACKAGE LIST (ListView)
             ========================= -->

        <!-- Removes the default ListView chrome (border/background) -->
        <Style x:Key="PackageListView"
               TargetType="ListView">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="False"/>

        </Style>


        <!-- Removes default selection/hover chrome from each list item -->
        <Style x:Key="PackageListViewItem"
               TargetType="ListViewItem">

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,0,0,10"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListViewItem">

                        <ContentPresenter/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- Card look for a single package row -->
        <Style x:Key="PackageCardBorder"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="14,12"/>

        </Style>

    </Window.Resources>


    <!-- =========================
         MAIN LAYOUT
         ========================= -->

    <Grid Margin="24">

        <Grid.ColumnDefinitions>

            <ColumnDefinition
                Width="1.35*"/>

            <ColumnDefinition
                Width="24"/>

            <ColumnDefinition
                Width="1*"/>

        </Grid.ColumnDefinitions>


        <!-- =========================
             LEFT CARD
             ========================= -->

        <Border
            Grid.Column="0"
            Background="{StaticResource CardBrush}"
            CornerRadius="18"
            Padding="36">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- TITLE -->

                <StackPanel
                    Grid.Row="0">

                    <TextBlock
                        Text="{x:Static res:Resources.Str_RegisterTitle}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

                    <TextBlock
                        Text="{x:Static res:Resources.Str_RegisterSubtitle}"
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Margin="0,5,0,0"/>

                </StackPanel>


                <!-- TOP FIELDS -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>


                    <!-- PACKAGE TYPE -->

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="{x:Static res:Resources.Str_LabelPackageType}"
                            Style="{StaticResource FieldLabel}"/>

                        <ComboBox
                            x:Name="CmbLiik"
                            SelectionChanged="VormValja_Muudetud"
                            Style="{StaticResource ModernComboBox}"/>

                    </StackPanel>


                    <!-- WEIGHT -->

                    <StackPanel Grid.Column="2">

                        <TextBlock
                            Text="{x:Static res:Resources.Str_LabelWeight}"
                            Style="{StaticResource FieldLabel}"/>

                        <TextBox
                            x:Name="TxtKaal"
                            Style="{StaticResource ModernTextBox}"
                            TextChanged="VormValja_Muudetud"
                            Text=""/>

                    </StackPanel>

                </Grid>


                <!-- DESTINATION -->

                <TextBlock
                    Grid.Row="4"
                    Text="{x:Static res:Resources.Str_LabelDestination}"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>


                <Grid
                    Grid.Row="5"
                    Margin="0,18,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="18"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="18"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>


                    <!-- CITY -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock
                            Text="{x:Static res:Resources.Str_LabelCity}"
                            Style="{StaticResource FieldLabel}"/>

                        <ComboBox
                            x:Name="CmbLinn"
                            Style="{StaticResource ModernComboBox}"
                            SelectionChanged="VormValja_Muudetud"/>

                    </StackPanel>


                    <!-- DELIVERY -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock
                            Text="{x:Static res:Resources.Str_LabelDelivery}"
                            Style="{StaticResource FieldLabel}"/>

                        <ComboBox
                            x:Name="CmbTarneviis"
                            Style="{StaticResource ModernComboBox}"
                            SelectionChanged="VormValja_Muudetud"
                            />

                    </StackPanel>


                    <!-- ADDRESS -->

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3">

                        <TextBlock
                            Text="{x:Static res:Resources.Str_LabelAddress}"
                            Style="{StaticResource FieldLabel}"/>

                        <TextBox
                            x:Name="TxtAadress"
                            Style="{StaticResource ModernTextBox}"
                            TextChanged="VormValja_Muudetud"
                            Text=""/>

                    </StackPanel>


                    <!-- BUTTONS -->

                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left" Grid.ColumnSpan="3" Width="352">

                        <Button
                            x:Name="BtnPrimary"
                            Width="150"
                            Content="{x:Static res:Resources.Str_ButtonSend}"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnPrimary_Click"/>

                        <Button
                            x:Name="BtnKustuta"
                            Width="109"
                            Margin="12,0,0,0"
                            IsEnabled="False"
                            Content="{x:Static res:Resources.Str_ButtonDelete}"
                            Style="{StaticResource DangerButton}"
                            Click="BtnKustuta_Click" Foreground="{DynamicResource SecondaryTextBrush}"/>

                    </StackPanel>


                    <!-- PRICE -->

                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="2"
                        HorizontalAlignment="Right">

                        <TextBlock
                            Text="{x:Static res:Resources.Str_LabelPrice}"
                            FontSize="13"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Right"/>

                        <TextBlock
                            x:Name="TxtHind"
                            Text="{x:Static res:Resources.Str_PriceDefault}"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"
                            HorizontalAlignment="Right"
                            Margin="0,2,0,0"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>


        <!-- =========================
             RIGHT CARD
             ========================= -->

        <Border
            Grid.Column="2"
            Background="{StaticResource CardBrush}"
            CornerRadius="18"
            Padding="28">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="24"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TITLE -->

                <TextBlock
                    Grid.Row="0"
                    Text="{x:Static res:Resources.Str_SentPackagesTitle}"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>


                <!-- PACKAGE LIST -->

                <ListView
                    x:Name="LstSaadetised"
                    Grid.Row="2"
                    d:ItemsSource="{d:SampleData ItemCount=5}"
                    Style="{StaticResource PackageListView}"
                    ItemContainerStyle="{StaticResource PackageListViewItem}"
                    SelectionChanged="LstSaadetised_SelectionChanged"
                    Margin="0">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Style="{StaticResource PackageCardBorder}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- LINN / LIIK / TARNEVIIS / KAAL / AADRESS -->

                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="{Binding Linn}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextBrush}"/>

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Margin="0,3,0,0">

                                            <TextBlock
                                                Text="{Binding Liik}"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

                                            <TextBlock
                                                Text=" • "
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

                                            <TextBlock
                                                Text="{Binding Tarneviis}"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

                                            <TextBlock
                                                Text=" • "
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

                                            <TextBlock
                                                Text="{Binding Kaal, StringFormat='{}{0} kg'}"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

                                        </StackPanel>

                                        <TextBlock
                                            Text="{Binding Aadress}"
                                            FontSize="12"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Margin="0,3,0,0"
                                            TextTrimming="CharacterEllipsis"/>

                                        <Border
                                            Background="#F0F0F0"
                                            CornerRadius="6"
                                            Padding="7,3"
                                            Margin="0,5,0,0"
                                            HorizontalAlignment="Left">

                                            <TextBlock
                                                Text="{Binding Staatus}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}"/>   

                                        </Border>

                                    </StackPanel>


                                    <!-- HIND -->

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Hind, StringFormat='{}{0:0.00} €'}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextBrush}"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

    </Grid>

</Window>
